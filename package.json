{
  "name": "poxilauncher",
  "productName": "PoxiLauncher",
  "version": "0.6.1",
  "description": "Launcher de Minecraft para jugar con tus amigos: instancias, mods sincronizados e invitaciones",
  "author": "Poxi",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "bins": "node scripts/fetch-7zip.mjs",
    "dist": "npm run bins && npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@xmcl/core": "^2.15.1",
    "@xmcl/installer": "^6.1.2",
    "@xmcl/unzip": "^2.1.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "gifenc": "^1.0.3",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "skinview3d": "^3.4.2",
    "typescript": "^5.9.3",
    "undici": "^7.30.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "overrides": {
    "undici": "$undici"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
